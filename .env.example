# Copy to .env and supply your own strong bootstrap password (at least 12 characters).
# Bootstrap creates the Ubuntu account only when no Super Admin exists.
UBUNTU_ADMIN_USERNAME=ubuntu.admin
UBUNTU_ADMIN_PASSWORD=
DATABASE_PATH=var/pronto.sqlite
PORT=5173
HOST=127.0.0.1
# Production: NODE_ENV=production, HTTPS reverse proxy and exact public origin.
# APP_ORIGIN=https://pos.example.com
# STATIC_ROOT=dist
# Public Supabase publishable config is included in src/pronto-supabase-config.js for the separate read-only auth test.
# Never expose sb_secret_* or a service_role key in the browser or in Git.
# For the future server migration, configure server secrets only in the deployment environment.
